PORT=3000
STEKKER_NAAM=OpenZaak-stekker
STEKKER_OMSCHRIJVING=Stekker voor zaken in Open Zaak (Zaken, Documenten en Besluiten API).
STEKKER_CONFIGURATIEVERSIE=openzaak-2026-10-10
STEKKER_DATASOURCE_NAME=openzaak
STEKKER_RUNTIME_SELECTIES_PATH=runtime/selecties
STEKKER_RUNTIME_VERNIETIGINGEN_PATH=runtime/vernietigingen
STEKKER_RUNTIME_JOURNAAL_PATH=runtime/journaal
STEKKER_RUNTIME_IDEMPOTENCY_PATH=runtime/idempotency
STEKKER_RUNTIME_LOCK_PATH=runtime/instance.lock
SELECTIE_PROCESSING_DELAY_MS=100
VERNIETIGING_PROCESSING_DELAY_MS=100
# Pogingen per kandidaat bij een fout in Open Zaak, met oplopende wachttijd (2 s, 4 s, ...).
VERNIETIGING_MAX_POGINGEN=3
VERNIETIGING_WACHTTIJD_POGING_MS=2000
MAX_BODY_BYTES=1048576
LOG_REQUESTS=true

# Open Zaak. Client-id en secret van de applicatie in Open Zaak (Autorisaties); het secret
# hoort niet in git. Nodige scopes: zie README (o.a. zaken.geforceerd-bijwerken voor gesloten
# zaken). De Selectielijst API is openbaar.
OPENZAAK_ZAKEN_URL=http://localhost:8000/zaken/api/v1/
OPENZAAK_DOCUMENTEN_URL=http://localhost:8000/documenten/api/v1/
OPENZAAK_BESLUITEN_URL=http://localhost:8000/besluiten/api/v1/
OPENZAAK_CATALOGI_URL=http://localhost:8000/catalogi/api/v1/
OPENZAAK_CLIENT_ID=vernietigingscockpit-stekker
OPENZAAK_SECRET=
SELECTIELIJST_URL=https://selectielijst.openzaak.nl/api/v1/
OPENZAAK_TIMEOUT_MS=30000
OPENZAAK_PARALLEL=8
OPENZAAK_GET_POGINGEN=3
# Leeg = alle zaaktypen; anders kommagescheiden identificaties.
OPENZAAK_ZAAKTYPEN=

# MDTO-gegevens (Stekker API v2, ADR-0005).
STEKKER_ARCHIEFVORMER=Gemeente Voorbeeld
STEKKER_IDENTIFICATIEBRON_TECHNISCH=Open Zaak Zaken API (zaak-URL)
STEKKER_IDENTIFICATIEBRON_KENMERK=Zaaknummering gemeente Voorbeeld
STEKKER_IDENTIFICATIEBRON_DOCUMENT=Documentnummering gemeente Voorbeeld
STEKKER_IDENTIFICATIEBRON_BESLUIT=Besluitnummering gemeente Voorbeeld
# Een label uit Cockpit-vernietigingsmethoden: Verwijderd via bronfunctie, Fysiek verwijderd,
# Overschreven, Cryptografisch onleesbaar gemaakt of Overig.
STEKKER_VERNIETIGINGSMETHODE=Verwijderd via bronfunctie
STEKKER_VERNIETIGINGSMETHODE_TOELICHTING=

# OAuth2/JWT. In compose standaard aan (AUTH_ENABLED=true), bij `npm start` standaard uit.
# AUTH_ENABLED=true
AUTH_ISSUER=https://auth.example.test/realms/vernietigingscockpit
AUTH_JWKS_URL=https://auth.example.test/realms/vernietigingscockpit/protocol/openid-connect/certs
AUTH_AUDIENCE=

# Scenario's voor foutpaden (standaard uit; zie README).
SCENARIO_FAILED_PERCENTAGE=0
SCENARIO_CHANGED_PERCENTAGE=0
SCENARIO_NOT_FOUND_PERCENTAGE=0
SCENARIO_SKIPPED_PERCENTAGE=0
SCENARIO_SELECTIE_FAIL=false
SCENARIO_LEVER_NIET_V=false
SCENARIO_HTTP_FAIL_FIRST_N=0
SCENARIO_HTTP_FAIL_STATUS=503
SCENARIO_HTTP_FAIL_MODE=voor
SCENARIO_HTTP_FAIL_ENDPOINTS=
SCENARIO_HTTP_DELAY_MS=0

# Voor docker compose; geef elke instantie een eigen naam, domein, router en runtime-volume.
COMPOSE_PROJECT_NAME=stekker-openzaak
STEKKER_CONTAINER_NAME=stekker-openzaak
STEKKER_RUNTIME_VOLUME=stekker-openzaak-runtime

# Traefik moet al draaien op deze externe Docker-network.
TRAEFIK_NETWORK=traefik
TRAEFIK_ROUTER_NAME=stekker-openzaak
TRAEFIK_SERVICE_NAME=stekker-openzaak
STEKKER_DOMAIN=stekker-openzaak.localhost
TRAEFIK_ENTRYPOINTS=web
TRAEFIK_TLS=false
TRAEFIK_CERTRESOLVER=
